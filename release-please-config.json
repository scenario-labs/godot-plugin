{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "pull-request-title-pattern": "chore: release${component} ${version}",
  "bootstrap-sha": "910ab7deb76bc560d82c2eb088e776969c1b6bb2",
  "packages": {
    ".": {
      "release-type": "simple",
      "draft": true,
      "component": "godot-plugin",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "-",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance Improvements" },
        { "type": "revert", "section": "Reverts" },
        { "type": "docs", "section": "Documentation" },
        { "type": "chore", "section": "Miscellaneous Chores" },
        { "type": "ci", "section": "Continuous Integration" },
        { "type": "test", "section": "Tests" },
        { "type": "refactor", "section": "Code Refactoring" },
        { "type": "build", "section": "Build System" },
        { "type": "style", "section": "Styles" }
      ],
      "extra-files": [
        { "type": "generic", "path": "addons/scenario/plugin.cfg" },
        { "type": "generic", "path": "addons/scenario/core/mcp_client.gd" },
        { "type": "generic", "path": "README.md" },
        { "type": "generic", "path": "docs/USER_GUIDE.md" }
      ]
    }
  }
}
